// Liveness: references held across many collections must survive, and must
// still hold exactly the bytes they held before.
//
// Surviving is the easy half. This case checks the other half as well: every
// field of every survivor is compared against the value it was built with, so
// an object that was swept and had its storage handed to something else shows
// up as a wrong answer rather than as a crash that might not happen.
import io

struct Record {
    id: int
    name: string
    scores: [int]
    next: Record?
}

fn make_record(id: int): Record {
    let scores: [int] = []
    for step in 0..8 {
        scores.push(id * 8 + step)
    }
    return Record { id: id, name: "record {id}", scores: scores, next: null }
}

// Allocates and abandons enough to force several collections.
fn churn(count: int) {
    let index = 0
    while index < count {
        let _waste = Record { id: index, name: "waste", scores: [], next: null }
        index += 1
    }
}

// Every field of every record still matches what `make_record` built.
fn verify(records: [Record]): int {
    let intact = 0
    for record in records {
        if record.name != "record {record.id}" {
            continue
        }
        if record.scores.length != 8 {
            continue
        }
        let ok = true
        for step in 0..8 {
            if record.scores[step] != record.id * 8 + step {
                ok = false
            }
        }
        if ok {
            intact += 1
        }
    }
    return intact
}

fn main() {
    let records: [Record] = []
    for id in 0..20000 {
        records.push(make_record(id))
    }

    // A chain woven through the same objects: the array is not the only path
    // to them, and the chain has to stay walkable too.
    for id in 1..20000 {
        records[id - 1].next = records[id]
    }

    io.println(verify(records))

    churn(200000)
    io.println(verify(records))

    churn(200000)
    io.println(verify(records))

    // Walk the chain from the head and confirm it still reaches every record.
    let cursor: Record? = records[0]
    let walked = 0
    let sum = 0
    while cursor != null {
        let record = cursor.expect("the loop condition just checked this")
        walked += 1
        sum += record.id
        cursor = record.next
    }
    io.println(walked)
    io.println(sum)
}
