// A wide object graph in every shape the collector traces differently:
// structs, enums with payloads, tuples, boxed optionals, interface values,
// generic containers and closures, all sharing substructure and all reachable
// from one root.
//
// Each of those has its own entry in the collector's trace plan, so a graph
// that mixes them is the case where a wrong plan for one kind shows up as a
// wrong answer from a traversal that never touches the others directly.
import io

struct Tag {
    text: string
}

enum Payload {
    Empty
    Number(int)
    Pair(int, int)
    Labelled(Tag)
}

struct TreeNode {
    id: int
    payload: Payload
    tags: [Tag]
    left: TreeNode?
    right: TreeNode?
    parent: TreeNode?
}

struct Box<T> {
    value: T
}

interface Described {
    fn describe(): string
}

struct Leaf {
    id: int

    fn describe(): string {
        return "leaf {id}"
    }
}

struct Branch {
    count: int

    fn describe(): string {
        return "branch {count}"
    }
}

implements Leaf: Described
implements Branch: Described

// Builds a complete binary tree of `depth` levels, with parent back-pointers,
// so the graph is full of cycles and every node is shared between two paths.
fn build(id: int, depth: int, shared: Tag): TreeNode {
    let payload: Payload = Payload.Empty
    if id % 4 == 1 {
        payload = Payload.Number(id)
    } else if id % 4 == 2 {
        payload = Payload.Pair(id, id * 2)
    } else if id % 4 == 3 {
        payload = Payload.Labelled(shared)
    }

    let node = TreeNode {
        id: id
        payload: payload
        tags: [shared, Tag { text: "tag {id}" }]
        left: null
        right: null
        parent: null
    }

    if depth > 1 {
        let left = build(id * 2, depth - 1, shared)
        let right = build(id * 2 + 1, depth - 1, shared)
        left.parent = node
        right.parent = node
        node.left = left
        node.right = right
    }
    return node
}

// Sums a value derived from every node's payload, so a variant whose pointer
// map is wrong changes the total.
