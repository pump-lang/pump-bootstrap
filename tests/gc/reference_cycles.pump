// Reference cycles: the case a reference count cannot reclaim, and the reason
// this collector is mark-sweep.
//
// Three shapes are built and abandoned over and over: a ring, a node pointing
// at itself, and a two-struct cycle that passes through a third object. The
// totals below add up to far more than the heap ever holds, so if a cycle
// leaked the process would not survive the loop.
import io

struct Ring {
    id: int
    next: Ring?
}

struct Owner {
    name: string
    pet: Pet?
}

struct Pet {
    name: string
    owner: Owner?
}

// Builds a closed ring of `length` nodes and returns the sum of its ids,
// walked the whole way round.
fn ring_sum(length: int): int {
    let head = Ring { id: 0, next: null }
    let tail = head
    for index in 1..length {
        let node = Ring { id: index, next: null }
        tail.next = node
        tail = node
    }
    // Closing the ring is what makes it unreachable-but-self-referential once
    // `head` goes out of scope.
    tail.next = head

    let sum = 0
    let cursor = head
    for _ in 0..length {
        sum += cursor.id
        cursor = cursor.next.expect("the ring is closed")
    }
    return sum
}

// A node whose only reference is to itself.
fn self_cycle(value: int): int {
    let node = Ring { id: value, next: null }
    node.next = node
    return node.next.expect("just assigned").id
}

// Two objects that reference each other, both reachable only from the pair.
fn mutual_cycle(index: int): int {
    let owner = Owner { name: "owner {index}", pet: null }
    let pet = Pet { name: "pet {index}", owner: owner }
    owner.pet = pet
    return owner.pet.expect("just assigned").name.length
}

fn main() {
    // Four thousand rings of sixty nodes: two hundred forty thousand nodes,
    // every one of them part of a cycle, every one of them dropped.
    let rings = 0
    for _ in 0..4000 {
        rings += ring_sum(60)
    }
    io.println(rings)

    let selves = 0
    for index in 0..200000 {
        selves += self_cycle(index) % 3
    }
    io.println(selves)

    let mutuals = 0
    for index in 0..100000 {
        mutuals += mutual_cycle(index)
    }
    io.println(mutuals)

    // A cycle that is still reachable survives, intact, at the end of all that.
    let live = Ring { id: 1, next: null }
    let second = Ring { id: 2, next: live }
    live.next = second
    let scratch = 0
    for index in 0..100000 {
        scratch += self_cycle(index) % 2
    }
    io.println(live.next.expect("live cycle").id)
    io.println(live.next.expect("live cycle").next.expect("live cycle").id)
    io.println(scratch)
}
