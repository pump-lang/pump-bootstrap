// Allocation pressure: many times the collection threshold, almost all of it
// garbage, with a small live set held across every cycle.
//
// The heap collects at a live-set watermark that starts at one mebibyte, so
// the loop below - half a million thirty-two byte nodes, sixteen mebibytes of
// churn - forces the collector to run many times over. Every number printed is
// a checksum of work the loop did, so a collector that freed something live
// would change the answer rather than merely crashing.
import io

struct Node {
    value: int
    next: Node?
}

struct Anchor {
    label: string
    total: int
}

// Allocates and immediately abandons `count` nodes, returning a checksum that
// depends on every one of them.
fn churn(count: int): int {
    let checksum = 0
    let index = 0
    while index < count {
        let node = Node { value: index, next: null }
        checksum += node.value % 7
        index += 1
    }
    return checksum
}

fn main() {
    // A live set that must survive every collection the churn provokes.
    let anchors: [Anchor] = []
    for index in 0..16 {
        anchors.push(Anchor { label: "anchor {index}", total: index * index })
    }

    io.println(churn(500000))

    // Interleave: more churn between reads of the live set.
    let seen = 0
    for round in 0..4 {
        seen += churn(50000)
        seen += anchors[round].total
    }
    io.println(seen)

    // Every anchor is still exactly what it was.
    let intact = 0
    for index in 0..16 {
        let anchor = anchors[index]
        if anchor.label == "anchor {index}" && anchor.total == index * index {
            intact += 1
        }
    }
    io.println(intact)
    io.println(anchors.length)
}
