// Specification section 14 with grammar 15: tuple, struct and or-patterns,
// nested variant payloads, and `..` for the fields a pattern ignores.
import io

struct Point {
    x: int
    y: int
}

enum Tree {
    Leaf(int)
    Node(Tree, Tree)
}

enum Event {
    Click(Point)
    Key(char)
    Quit
}

fn quadrant(point: Point): string {
    match point {
        Point { x: 0, y: 0 } => return "origin"
        Point { x: 0, y: _ } => return "on the y axis"
        Point { x: _, y: 0 } => return "on the x axis"
        Point { x, y } => return "at {x},{y}"
    }
}

fn depth(tree: Tree): int {
    match tree {
        Tree.Leaf(_) => return 1
        Tree.Node(left, right) => {
            let a = depth(left)
            let b = depth(right)
            if a > b {
                return a + 1
            }
            return b + 1
        }
    }
}

fn describe(pair: (int, string)): string {
    match pair {
        (0, text) => return "zero:{text}"
        (n, "stop") => return "stop at {n}"
        (n, text) => return "{n}:{text}"
    }
}

fn handle(event: Event): string {
    match event {
        Event.Click(Point { x, .. }) => return "click at x={x}"
        Event.Key('q') | Event.Key('Q') => return "quit key"
        Event.Key(letter) => return "key {letter}"
        Event.Quit => return "quit"
    }
}

fn main() {
    io.println(quadrant(Point { x: 0, y: 0 }))
    io.println(quadrant(Point { x: 0, y: 4 }))
    io.println(quadrant(Point { x: 4, y: 0 }))
    io.println(quadrant(Point { x: 2, y: 3 }))

    let tree = Tree.Node(Tree.Leaf(1), Tree.Node(Tree.Leaf(2), Tree.Leaf(3)))
    io.println(depth(tree))

    io.println(describe((0, "a")))
    io.println(describe((7, "stop")))
    io.println(describe((7, "go")))

    io.println(handle(Event.Click(Point { x: 9, y: 1 })))
    io.println(handle(Event.Key('Q')))
    io.println(handle(Event.Key('z')))
    io.println(handle(Event.Quit))
}
