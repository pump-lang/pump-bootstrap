// Decision D-17: `catch` has three forms - a default expression, a binder,
// and a block that must diverge.
import io

fn parse(text: string): int! {
    if text == "42" {
        return 42
    }
    fail "cannot parse `{text}`"
}

fn with_binder(text: string): string {
    let value = parse(text) catch error {
        return "failed: {error.message()}"
    }
    return "ok: {value}"
}

fn with_block(text: string): int {
    let value = parse(text) catch {
        io.println("giving up on {text}")
        return -1
    }
    return value
}

fn main() {
    // Form one: a default expression.
    io.println(parse("42") catch 0)
    io.println(parse("x") catch 0)

    // Form two: bind the error and handle it.
    io.println(with_binder("42"))
    io.println(with_binder("nope"))

    // Form three: a block that diverges.
    io.println(with_block("42"))
    io.println(with_block("nope"))

    // A `catch` default may itself be an arbitrary expression.
    let fallback = 7
    io.println(parse("x") catch fallback * 2)
}
