// Decision D-17: `catch` has three forms - a default expression, a binder,
// and a block that must diverge.
import io

fn parse(text: string): int! {
    if text == "42" {
        return 42
    }
    fail "cannot parse `{text}`"
}

fn with_binder(text: string): string {
    let value = parse(text) catch error {
        return "failed: {error.message()}"
    }
    return "ok: {value}"
}

fn with_block(text: string): int {
    let value = parse(text) catch {
        io.println("giving up on {text}")
        return -1
    }
    return value
}
