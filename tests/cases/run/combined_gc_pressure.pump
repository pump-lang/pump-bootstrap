// Allocation-heavy work, so the collector runs during a program that also
// keeps live data across it. Every number below is deterministic.
import io

struct Node {
    value: int
    next: Node?
}

fn build(length: int): Node? {
    let head: Node? = null
    let i = length
    while i > 0 {
        head = Node { value: i, next: head }
        i -= 1
    }
    return head
}

fn total(list: Node?): int {
    let sum = 0
    let cursor = list
    while cursor != null {
        let node = cursor.expect("the loop condition just checked this")
        sum += node.value
        cursor = node.next
    }
    return sum
}

fn churn(rounds: int): int {
    let survivors: [string] = []
    let i = 0
    while i < rounds {
        // Garbage: allocated and dropped immediately.
        let scratch: [int] = []
        let j = 0
        while j < 50 {
            scratch.push(i * j)
            j += 1
        }
        if i % 100 == 0 {
            survivors.push("round {i} sum {scratch[49]}")
        }
        i += 1
    }
    return survivors.length
}

fn main() {
    let list = build(1000)
    io.println(total(list))

    io.println(churn(1000))

    // The list built before the churn is still intact afterwards.
    io.println(total(list))

    let tables: [[string: int]] = []
    for i in 0..50 {
        let table: [string: int] = {}
        for j in 0..20 {
            table.insert("k{j}", i * j)
        }
        tables.push(table)
    }
    io.println(tables.length)
    io.println(tables[49]["k19"])
}
