// Generics, interfaces, closures and optionals composed into one small
// pipeline: a generic sequence type whose operations take function values.
import io

interface Describable {
    fn describe(): string
}

struct Sequence<T> {
    values: [T]

    fn length(): int {
        return values.length
    }

    fn add(value: T) {
        values.push(value)
    }

    fn at(index: int): T? {
        if index < 0 {
            return null
        }
        if index >= values.length {
            return null
        }
        return values[index]
    }

    fn fold(seed: int, step: fn(int, T): int): int {
        let accumulator = seed
        for value in values {
            accumulator = step(accumulator, value)
        }
        return accumulator
    }

    fn keep(predicate: fn(T): bool): Sequence<T> {
        let kept: [T] = []
        for value in values {
            if predicate(value) {
                kept.push(value)
            }
        }
        return Sequence { values: kept }
    }
}

struct Reading {
    sensor: string
    celsius: int

    fn describe(): string {
        return "{sensor}={celsius}C"
    }
}

implements Reading: Describable

// Arrays are invariant, so `[Reading]` is not an `[Describable]`. A bounded
// generic parameter accepts either.
fn render<T: Describable>(items: [T]): string {
    let out = ""
    for item in items {
        if out != "" {
            out += ", "
        }
        out += item.describe()
    }
    return out
}

fn main() {
    let numbers: Sequence<int> = Sequence { values: [] }
    for i in 1..=6 {
        numbers.add(i)
    }
    io.println(numbers.length())
    io.println(numbers.fold(0, fn(total: int, value: int): int {
        return total + value
    }))

    let even = numbers.keep(fn(value: int): bool {
        return value % 2 == 0
    })
    io.println(even.length())
    io.println(even.fold(1, fn(product: int, value: int): int {
        return product * value
    }))

    io.println(even.at(0).or(-1))
    io.println(even.at(9).or(-1))

    let readings: Sequence<Reading> = Sequence { values: [] }
    readings.add(Reading { sensor: "a", celsius: 21 })
    readings.add(Reading { sensor: "b", celsius: -4 })
    readings.add(Reading { sensor: "c", celsius: 30 })

    io.println(render(readings.values))

    let warm = readings.keep(fn(reading: Reading): bool {
        return reading.celsius > 0
    })
    io.println(render(warm.values))
    io.println(warm.fold(0, fn(total: int, reading: Reading): int {
        return total + reading.celsius
    }))
}
