// Edge case E-23: `T?!` is an error of optional and `T!?` is an optional of
// error; both are legal and they differ.
import io

struct Record {
    id: int
}

// May fail, and on success may still have nothing to give.
fn lookup(id: int): Record?! {
    if id < 0 {
        fail "negative id"
    }
    if id == 0 {
        return null
    }
    return Record { id: id }
}

// Never fails; returns an optional.
fn quiet_lookup(id: int): Record? {
    return lookup(id) catch null
}

fn describe(id: int): string {
    let found = lookup(id) catch error {
        return "error: {error.message()}"
    }
    if found == null {
        return "absent"
    }
    return "record {found.id}"
}
