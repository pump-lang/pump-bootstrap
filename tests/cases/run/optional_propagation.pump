// Specification section 15 with decision D-13: postfix `?` returns null from
// the enclosing function rather than force-unwrapping.
import io

struct User {
    name: string
    manager: User?
}

fn find(name: string): User? {
    if name == "minh" {
        return User { name: "Minh", manager: null }
    }
    if name == "an" {
        return User { name: "An", manager: User { name: "Boss", manager: null } }
    }
    return null
}

fn manager_name(name: string): string? {
    let user = find(name)?
    let manager = user.manager?
    return manager.name
}

fn first_char(text: string): char? {
    if text.length == 0 {
        return null
    }
    return text.chars()[0]
}

fn shout(text: string): string? {
    let letter = first_char(text)?
    return "{letter}!"
}

fn main() {
    io.println(manager_name("an").or("none"))
    io.println(manager_name("minh").or("none"))
    io.println(manager_name("nobody").or("none"))

    io.println(shout("hi").or("-"))
    io.println(shout("").or("-"))

    // `x?.field` reads as optional chaining and behaves as propagation.
    io.println(chained("an").or("none"))
}

fn chained(name: string): string? {
    return find(name)?.manager?.name
}
