// Specification section 18: interfaces are structural, and `implements` is an
// optional explicit conformance check.
import io

interface Named {
    fn label(): string
}

interface Sized {
    fn size(): int
}

struct File {
    path: string
    bytes: int

    fn label(): string {
        return "file {path}"
    }

    fn size(): int {
        return bytes
    }
}

struct Folder {
    name: string
    children: [string]

    fn label(): string {
        return "folder {name}"
    }

    fn size(): int {
        return children.length
    }
}

implements File: Named
implements Folder: Named
