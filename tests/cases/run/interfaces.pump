// Specification section 18: interfaces are structural, and `implements` is an
// optional explicit conformance check.
import io

interface Named {
    fn label(): string
}

interface Sized {
    fn size(): int
}

struct File {
    path: string
    bytes: int

    fn label(): string {
        return "file {path}"
    }

    fn size(): int {
        return bytes
    }
}

struct Folder {
    name: string
    children: [string]

    fn label(): string {
        return "folder {name}"
    }

    fn size(): int {
        return children.length
    }
}

implements File: Named
implements Folder: Named

fn announce(item: Named) {
    io.println(item.label())
}

fn total_size(items: [Sized]): int {
    let total = 0
    for item in items {
        total += item.size()
    }
    return total
}

fn describe<T: Named>(item: T): string {
    return "<{item.label()}>"
}

fn main() {
    let file = File { path: "/tmp/a", bytes: 120 }
    let folder = Folder { name: "docs", children: ["a", "b"] }

    announce(file)
    announce(folder)

    // Structural conformance: no `implements` needed for `Sized`.
    let sized: [Sized] = [file, folder]
    io.println(total_size(sized))

    io.println(describe(file))
    io.println(describe(folder))

    // The builtin `Stringable` interface backs interpolation.
    io.println("{file.label()} of {file.size()}")
}
