// Several features at once: structs with methods, an enum with payloads, an
// exhaustive match, optionals, maps, sorting through closures, and a failable
// lookup.
import io

struct Item {
    name: string
    price: int
    quantity: int

    fn total(): int {
        return price * quantity
    }
}

enum Change {
    Add(Item)
    Remove(string)
    Restock(string, int)
}

struct Inventory {
    items: [Item]

    fn find(name: string): Item? {
        for item in items {
            if item.name == name {
                return item
            }
        }
        return null
    }

    fn value(): int {
        let total = 0
        for item in items {
            total += item.total()
        }
        return total
    }

    fn apply(change: Change): string {
        match change {
            Change.Add(item) => {
                items.push(item)
                return "added {item.name}"
            }
            Change.Remove(name) => {
                let kept: [Item] = []
                let found = false
                for item in items {
                    if item.name == name {
                        found = true
                    } else {
                        kept.push(item)
                    }
                }
                items = kept
                if found {
                    return "removed {name}"
                }
                return "no such item {name}"
            }
            Change.Restock(name, amount) => {
                let item = this.find(name)
                if item == null {
                    return "cannot restock {name}"
                }
                item.quantity += amount
                return "restocked {name} to {item.quantity}"
            }
        }
    }

    fn price_of(name: string): int! {
        let item = this.find(name)
        if item == null {
            fail "unknown item `{name}`"
        }
        return item.price
    }
}

fn main() {
    let inventory = Inventory { items: [] }

    let changes = [
        Change.Add(Item { name: "bolt", price: 3, quantity: 100 }),
        Change.Add(Item { name: "nut", price: 2, quantity: 200 }),
        Change.Restock("bolt", 50),
        Change.Remove("washer"),
        Change.Add(Item { name: "washer", price: 1, quantity: 10 }),
        Change.Remove("nut"),
    ]

    for change in changes {
        io.println(inventory.apply(change))
    }

    io.println("value {inventory.value()}")
    io.println("bolt costs {inventory.price_of("bolt") catch -1}")
    io.println("gear costs {inventory.price_of("gear") catch -1}")

    let by_name: [string: int] = {}
    for item in inventory.items {
        by_name.insert(item.name, item.total())
    }
    for name in by_name.keys() {
        io.println("{name} -> {by_name[name]}")
    }
}
