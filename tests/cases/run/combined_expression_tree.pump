// A recursive enum evaluated with a match, an error path through `fail` and
// `!`, and a generic helper reused for both sides.
import io

enum Expr {
    Number(int)
    Add(Expr, Expr)
    Sub(Expr, Expr)
    Mul(Expr, Expr)
    Div(Expr, Expr)
    Neg(Expr)
}

fn evaluate(expression: Expr): int! {
    match expression {
        Expr.Number(value) => return value
        Expr.Add(left, right) => return evaluate(left)! + evaluate(right)!
        Expr.Sub(left, right) => return evaluate(left)! - evaluate(right)!
        Expr.Mul(left, right) => return evaluate(left)! * evaluate(right)!
        Expr.Div(left, right) => {
            let divisor = evaluate(right)!
            if divisor == 0 {
                fail "division by zero"
            }
            return evaluate(left)! / divisor
        }
        Expr.Neg(inner) => return -evaluate(inner)!
    }
}

fn render(expression: Expr): string {
    match expression {
        Expr.Number(value) => return string(value)
        Expr.Add(left, right) => return "({render(left)} + {render(right)})"
        Expr.Sub(left, right) => return "({render(left)} - {render(right)})"
        Expr.Mul(left, right) => return "({render(left)} * {render(right)})"
        Expr.Div(left, right) => return "({render(left)} / {render(right)})"
        Expr.Neg(inner) => return "-{render(inner)}"
    }
}

// A `catch` fallback has to have the success type, so the error is turned
// into text by a handler block instead.
fn show(expression: Expr): string {
    let value = evaluate(expression) catch error {
        return "error: {error.message()}"
    }
    return string(value)
}

fn report(expression: Expr) {
    io.println("{render(expression)} = {show(expression)}")
}

fn main() {
    let one = Expr.Number(1)
    let two = Expr.Number(2)
    let three = Expr.Number(3)

    report(Expr.Add(one, two))
    report(Expr.Mul(Expr.Add(one, two), three))
    report(Expr.Sub(three, Expr.Neg(two)))
    report(Expr.Div(Expr.Number(10), two))
    report(Expr.Div(one, Expr.Sub(two, two)))
}
