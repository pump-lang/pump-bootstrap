// Specification section 5: `fn`, explicit returns, no implicit tail return.
import io

fn add(a: int, b: int): int {
    return a + b
}

fn hello(name: string) {
    io.println("Hello " + name)
}

fn max(a: int, b: int): int {
    if a > b {
        return a
    }

    return b
}

fn nothing() {
    return
}

fn recurse(n: int): int {
    if n <= 1 {
        return 1
    }
    return n * recurse(n - 1)
}

fn main() {
    io.println(add(2, 3))
    hello("Minh")
    io.println(max(4, 9))
    nothing()
    io.println(recurse(5))
}
