// Specification section 7: `if`, `else`, `else if`, and no `elif`.
import io

fn grade(score: int): string {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else {
        return "C"
    }
}

fn main() {
    let age = 18
    if age >= 18 {
        io.println("adult")
    } else {
        io.println("minor")
    }

    io.println(grade(95))
    io.println(grade(85))
    io.println(grade(10))

    // `else` on its own line still joins the `if` (grammar 8.3, edge case E-8).
    if age < 0 {
        io.println("impossible")
    }
    else {
        io.println("fine")
    }

    if age > 0 && age < 200 {
        io.println("plausible")
    }
}
