// Specification section 4: arrays, and the builtin methods on them.
import io

fn main() {
    let numbers: [int] = [1, 2, 3, 4]
    io.println(numbers[0])
    io.println(numbers[3])
    io.println(numbers.length)

    numbers.push(5)
    io.println(numbers.length)
    io.println(numbers.pop())
    io.println(numbers.length)

    numbers[1] = 20
    io.println(numbers[1])

    let empty: [int] = []
    io.println(empty.length)

    let nested: [[int]] = [[1, 2], [3]]
    io.println(nested[0][1])
    io.println(nested.length)

    let joined = numbers.concat([9, 8])
    io.println(joined.length)
    io.println(joined[5])
    io.println(numbers.slice(1, 3).length)

    let words = ["a", "b", "c"]
    for word in words {
        io.print(word)
    }
    io.println("")
}
