// Specification section 12: methods live in the struct body, fields resolve
// directly, and an explicit receiver is spelled `this`.
import io

struct User {
    name: string
    age: int

    fn greet() {
        io.println("Hello " + name)
    }

    fn rename(name: string) {
        this.name = name
    }

    fn birthday(): int {
        age += 1
        return age
    }

    fn is_adult(): bool {
        return age >= 18
    }

    fn describe(): string {
        // One method calling another on the same receiver.
        return "{name} ({age}, adult={this.is_adult()})"
    }
}

struct Counter {
    value: int

    fn bump(step: int = 1) {
        value += step
    }
}

fn main() {
    let user = User { name: "Minh", age: 17 }
    user.greet()
    io.println(user.is_adult())
    io.println(user.birthday())
    io.println(user.is_adult())
    user.rename("An")
    user.greet()
    io.println(user.describe())

    let counter = Counter { value: 0 }
    counter.bump()
    counter.bump(10)
    io.println(counter.value)
}
