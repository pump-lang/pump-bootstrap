// Specification section 13: a plain enum and one carrying payloads.
import io

enum Color {
    Red
    Green
    Blue
}

enum Shape {
    Circle(float)
    Rect(float, float)
    Empty
}

fn name_of(color: Color): string {
    match color {
        Color.Red => return "red"
        Color.Green => return "green"
        Color.Blue => return "blue"
    }
}

fn area(shape: Shape): float {
    match shape {
        Shape.Circle(radius) => return 3.0 * radius * radius
        Shape.Rect(width, height) => return width * height
        Shape.Empty => return 0.0
    }
}

fn main() {
    io.println(name_of(Color.Red))
    io.println(name_of(Color.Blue))

    let colors = [Color.Red, Color.Green, Color.Blue]
    for color in colors {
        io.print(name_of(color) + " ")
    }
    io.println("")

    io.println(area(Shape.Circle(2.0)))
    io.println(area(Shape.Rect(3.0, 4.0)))
    io.println(area(Shape.Empty))

    // Enum values compare by variant and payload.
    io.println(Color.Red == Color.Red)
    io.println(Color.Red == Color.Green)
}
