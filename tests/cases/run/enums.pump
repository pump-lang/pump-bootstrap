// Specification section 13: a plain enum and one carrying payloads.
import io

enum Color {
    Red
    Green
    Blue
}

enum Shape {
    Circle(float)
    Rect(float, float)
    Empty
}

fn name_of(color: Color): string {
    match color {
        Color.Red => return "red"
        Color.Green => return "green"
        Color.Blue => return "blue"
    }
}

fn area(shape: Shape): float {
    match shape {
        Shape.Circle(radius) => return 3.0 * radius * radius
        Shape.Rect(width, height) => return width * height
        Shape.Empty => return 0.0
    }
}
