pub struct Catalogue {
    entries: [string: float]
    order: [string]
}

pub fn empty(): Catalogue {
    return Catalogue { entries: {}, order: [] }
}

pub fn add(catalogue: Catalogue, name: string, value: float) {
    if !catalogue.entries.has(name) {
        catalogue.order.push(name)
    }
    catalogue.entries.insert(name, value)
}

pub fn count(catalogue: Catalogue): int {
    return catalogue.entries.length
}

pub fn names(catalogue: Catalogue): [string] {
    return catalogue.order
}

pub fn lookup(catalogue: Catalogue, name: string): float! {
    let found = catalogue.entries.get(name)
    if found == null {
        fail "no entry named `{name}`"
    }
    return found
}
