pub interface Shape {
    fn area(): float
    fn name(): string
}

pub struct Circle {
    pub radius: float

    pub fn area(): float {
        return 3.0 * radius * radius
    }

    pub fn name(): string {
        return "circle"
    }
}

pub struct Square {
    pub side: float

    pub fn area(): float {
        return side * side
    }

    pub fn name(): string {
        return "square"
    }
}

implements Circle: Shape
implements Square: Shape

pub fn area<T: Shape>(shape: T): float {
    return shape.area()
}

pub fn render<T: Shape>(shape: T): string {
    return "{shape.name()} of {shape.area()}"
}
