// String helpers, written in Pump on top of the byte-level builtins
// (`length`, `byte_at`, `slice`, `chars`, `char_count`).
//
// The two measurements a string already answers for itself are not repeated
// here: `text.length` is the number of BYTES, and `text.char_count()` is the
// number of characters. Every offset below is a byte offset, matching `slice`
// and `byte_at`. Searching by bytes is safe for UTF-8: a valid needle begins
// with a lead byte, which never appears as a continuation byte, so a byte
// match always lands on a character boundary.
//
// Strings are immutable, so results are built by collecting the pieces into
// an array and handing them to `concat`, which joins them by halving rather
// than by appending one at a time. Appending in a loop copies the whole
// result on every step and costs O(n^2) in the output length; halving costs
// O(n log n). The pattern is worth copying in your own code.
//
// `to_upper` and `to_lower` map ASCII only. Case folding for the rest of
// Unicode needs tables the runtime does not carry.

const TAB: int = 9
const NEWLINE: int = 10
const RETURN: int = 13
const SPACE: int = 32
const PLUS: int = 43
const MINUS: int = 45
const DOT: int = 46
const DIGIT_ZERO: int = 48
const DIGIT_NINE: int = 57
const UPPER_A: int = 65
const UPPER_E: int = 69
const UPPER_Z: int = 90
const LOWER_A: int = 97
const LOWER_E: int = 101
const LOWER_Z: int = 122

// The distance from 'A' to 'a'. ASCII places the two cases exactly this far
// apart, which is what makes case mapping a single subtraction.
const CASE_GAP: int = 32

// -------------------------------------------------------------------------
// Inspecting
// -------------------------------------------------------------------------

pub fn is_empty(text: string): bool {
    return text.length == 0
}

// True when every character is a space, tab, carriage return or newline. An
// empty string is blank.
pub fn is_blank(text: string): bool {
    let index = 0
    while index < text.length {
        if !is_space(text.byte_at(index)) {
            return false
        }
        index += 1
    }
    return true
}

// The byte offset of the first occurrence of `needle`, or -1. An empty needle
// is found at 0.
pub fn index_of(text: string, needle: string): int {
    if needle.length == 0 {
        return 0
    }
    if needle.length > text.length {
        return -1
    }

    let last = text.length - needle.length
    for start in 0..=last {
        if matches_at(text, needle, start) {
            return start
        }
    }
    return -1
}

// The byte offset of the last occurrence of `needle`, or -1.
pub fn last_index_of(text: string, needle: string): int {
    if needle.length == 0 {
        return text.length
    }
    if needle.length > text.length {
        return -1
    }

    let start = text.length - needle.length
    while start >= 0 {
        if matches_at(text, needle, start) {
            return start
        }
        start -= 1
    }
    return -1
}

pub fn contains(text: string, needle: string): bool {
    return index_of(text, needle) >= 0
}

pub fn starts_with(text: string, prefix: string): bool {
    if prefix.length > text.length {
        return false
    }
    return matches_at(text, prefix, 0)
}

pub fn ends_with(text: string, suffix: string): bool {
    if suffix.length > text.length {
        return false
    }
    return matches_at(text, suffix, text.length - suffix.length)
}

// How many times `needle` occurs without overlapping itself. An empty needle
// occurs zero times, which keeps the answer finite.
pub fn count(text: string, needle: string): int {
    if needle.length == 0 || needle.length > text.length {
        return 0
    }

    let total = 0
    let cursor = 0
    let last = text.length - needle.length
    while cursor <= last {
        if matches_at(text, needle, cursor) {
            total += 1
            cursor += needle.length
        } else {
            cursor += 1
        }
    }
    return total
}

// -------------------------------------------------------------------------
// Splitting
// -------------------------------------------------------------------------

// Splits on every occurrence of `separator`. Adjacent separators produce
// empty parts, so the result always has one more element than there are
// separators. An empty separator returns the whole string as a single part.
pub fn split(text: string, separator: string): [string] {
    let parts: [string] = []
    if separator.length == 0 {
        parts.push(text)
        return parts
    }

    let start = 0
    let cursor = 0
    while cursor <= text.length - separator.length {
        if matches_at(text, separator, cursor) {
            parts.push(text.slice(start, cursor))
            cursor += separator.length
            start = cursor
        } else {
            cursor += 1
        }
    }
    parts.push(text.slice(start, text.length))
    return parts
}

// Splits on runs of whitespace, discarding empty parts. Leading and trailing
// whitespace produce nothing, so `split_whitespace("  a  b ")` is two parts.
pub fn split_whitespace(text: string): [string] {
    let parts: [string] = []
    let start = -1
    let index = 0
    while index < text.length {
        if is_space(text.byte_at(index)) {
            if start >= 0 {
                parts.push(text.slice(start, index))
                start = -1
            }
        } else if start < 0 {
            start = index
        }
        index += 1
    }
    if start >= 0 {
        parts.push(text.slice(start, text.length))
    }
    return parts
}

// Splits into lines on "\n", dropping one carriage return before each break
// so that Windows text behaves the same as Unix text. A trailing newline ends
// the last line rather than starting an empty one.
pub fn lines(text: string): [string] {
    let out: [string] = []
    let start = 0
    let index = 0
    while index < text.length {
        if text.byte_at(index) == NEWLINE {
            out.push(without_return(text.slice(start, index)))
            start = index + 1
        }
        index += 1
    }
    if start < text.length {
        out.push(without_return(text.slice(start, text.length)))
    }
    return out
}

// -------------------------------------------------------------------------
// Building
// -------------------------------------------------------------------------

// Joins every part end to end. The halving keeps the total bytes copied at
// O(n log n) instead of the O(n^2) that appending one part at a time costs.
pub fn concat(parts: [string]): string {
    return concat_range(parts, 0, parts.length)
}

pub fn join(parts: [string], separator: string): string {
    if separator.length == 0 {
        return concat(parts)
    }

    let pieces: [string] = []
    pieces.reserve(parts.length * 2)
    let index = 0
    while index < parts.length {
        if index > 0 {
            pieces.push(separator)
        }
        pieces.push(parts[index])
        index += 1
    }
    return concat(pieces)
}

pub fn replace(text: string, from: string, to: string): string {
    if from.length == 0 {
        return text
    }
    return join(split(text, from), to)
}

// `text` written `count` times. A count of zero or less gives "".
pub fn repeat(text: string, count: int): string {
    if count <= 0 || text.length == 0 {
        return ""
    }

    // Doubling: each pass squares the block, so the number of concatenations
    // is logarithmic in `count` rather than equal to it.
    let out = ""
    let block = text
    let remaining = count
    while remaining > 0 {
        if remaining % 2 == 1 {
            out += block
        }
        remaining /= 2
        if remaining > 0 {
            block += block
        }
    }
    return out
}

// Widens to `width` characters by adding `fill` on the left. Already-wide
// text is returned unchanged; it is never truncated.
pub fn pad_start(text: string, width: int, fill: char = ' '): string {
    let missing = width - text.char_count()
    if missing <= 0 {
        return text
    }
    return repeat(string(fill), missing) + text
}

pub fn pad_end(text: string, width: int, fill: char = ' '): string {
    let missing = width - text.char_count()
    if missing <= 0 {
        return text
    }
    return text + repeat(string(fill), missing)
}

pub fn reverse(text: string): string {
    let characters = text.chars()
    let pieces: [string] = []
    pieces.reserve(characters.length)
    let index = characters.length - 1
    while index >= 0 {
        pieces.push(string(characters[index]))
        index -= 1
    }
    return concat(pieces)
}

// -------------------------------------------------------------------------
// Trimming
// -------------------------------------------------------------------------

pub fn trim_start(text: string): string {
    let start = 0
    while start < text.length {
        if !is_space(text.byte_at(start)) {
            return text.slice(start, text.length)
        }
        start += 1
    }
    return ""
}

pub fn trim_end(text: string): string {
    let end = text.length
    while end > 0 {
        if !is_space(text.byte_at(end - 1)) {
            return text.slice(0, end)
        }
        end -= 1
    }
    return ""
}

pub fn trim(text: string): string {
    return trim_start(trim_end(text))
}

// -------------------------------------------------------------------------
// Case
// -------------------------------------------------------------------------

pub fn to_upper(text: string): string {
    return map_case(text, LOWER_A, LOWER_Z, -CASE_GAP)
}

pub fn to_lower(text: string): string {
    return map_case(text, UPPER_A, UPPER_Z, CASE_GAP)
}

// -------------------------------------------------------------------------
// Parsing
// -------------------------------------------------------------------------

// Reads a decimal integer, with an optional leading `+` or `-`. The whole
// string must be digits; trim it first if it may carry spaces. Fails rather
// than wrapping when the value will not fit an `int`.
pub fn to_int(text: string): int! {
    let index = 0
    let negative = false
    if text.length > 0 {
        let lead = text.byte_at(0)
        if lead == PLUS || lead == MINUS {
            negative = lead == MINUS
            index = 1
        }
    }
    if index == text.length {
        fail "`{text}` is not an integer"
    }

    // The digits accumulate as a negative number so that the most negative
    // int, whose magnitude has no positive counterpart, still parses.
    let value = 0
    while index < text.length {
        let digit = text.byte_at(index) - DIGIT_ZERO
        if digit < 0 || digit > 9 {
            fail "`{text}` is not an integer"
        }
        if value < (INT_MIN + digit) / 10 {
            fail "`{text}` does not fit an int"
        }
        value = value * 10 - digit
        index += 1
    }

    if negative {
        return value
    }
    if value == INT_MIN {
        fail "`{text}` does not fit an int"
    }
    return -value
}

// Reads a decimal float: an optional sign, digits, an optional fraction, and
// an optional `e`/`E` exponent. `"1"`, `"-2.5"` and `"6.02e23"` all parse.
//
// The result is within an ulp or so of the true value, not correctly rounded:
// the digits are accumulated in floating point and scaled once at the end.
// Values needing more than seventeen significant digits, or an exponent past
// the float range, lose accuracy or reach infinity as IEEE 754 says.
pub fn to_float(text: string): float! {
    let index = 0
    let negative = false
    if text.length > 0 {
        let lead = text.byte_at(0)
        if lead == PLUS || lead == MINUS {
            negative = lead == MINUS
            index = 1
        }
    }

    let digits = 0
    let value = 0.0
    while index < text.length && is_digit(text.byte_at(index)) {
        value = value * 10.0 + float(text.byte_at(index) - DIGIT_ZERO)
        digits += 1
        index += 1
    }

    // Digits after the point are read as if they came before it, then undone
    // by the scale below. One scaling keeps the rounding error to one step.
    let scale = 0
    if index < text.length && text.byte_at(index) == DOT {
        index += 1
        while index < text.length && is_digit(text.byte_at(index)) {
            value = value * 10.0 + float(text.byte_at(index) - DIGIT_ZERO)
            digits += 1
            scale += 1
            index += 1
        }
    }
    if digits == 0 {
        fail "`{text}` is not a number"
    }

    if index < text.length {
        let marker = text.byte_at(index)
        if marker != LOWER_E && marker != UPPER_E {
            fail "`{text}` is not a number"
        }
        scale -= read_exponent(text, index + 1)!
    }

    let result = scale_by_power_of_ten(value, scale)
    if negative {
        return -result
    }
    return result
}

// -------------------------------------------------------------------------
// Internals
// -------------------------------------------------------------------------

const INT_MIN: int = -9223372036854775807 - 1

// Past this the scaling has already reached infinity or zero, and clamping
// keeps the exponent well away from the overflow in `-exponent`.
const MAX_SCALE: int = 1000

fn matches_at(text: string, needle: string, start: int): bool {
    if start < 0 || start + needle.length > text.length {
        return false
    }

    let offset = 0
    while offset < needle.length {
        if text.byte_at(start + offset) != needle.byte_at(offset) {
            return false
        }
        offset += 1
    }
    return true
}

fn is_space(code: int): bool {
    return code == SPACE || code == TAB || code == NEWLINE || code == RETURN
}

fn is_digit(code: int): bool {
    return code >= DIGIT_ZERO && code <= DIGIT_NINE
}

fn without_return(line: string): string {
    if line.length > 0 && line.byte_at(line.length - 1) == RETURN {
        return line.slice(0, line.length - 1)
    }
    return line
}

// Splits the range in half and joins the two answers, so the deepest string
// is copied log2(n) times rather than n times.
fn concat_range(parts: [string], start: int, end: int): string {
    let count = end - start
    if count <= 0 {
        return ""
    }
    if count == 1 {
        return parts[start]
    }

    let middle = start + count / 2
    return concat_range(parts, start, middle) + concat_range(parts, middle, end)
}

// Shifts every byte in `[low, high]` by `delta`. ASCII case mapping never
// touches a byte above 127, so multi-byte characters pass through untouched.
fn map_case(text: string, low: int, high: int, delta: int): string {
    let pieces: [string] = []
    pieces.reserve(text.char_count())
    for character in text.chars() {
        let code = int(character)
        if code >= low && code <= high {
            pieces.push(string(char(code + delta)))
        } else {
            pieces.push(string(character))
        }
    }
    return concat(pieces)
}

// The signed exponent that follows `e`, clamped to a harmless magnitude.
fn read_exponent(text: string, start: int): int! {
    let rest = text.slice(start, text.length)
    if rest.length == 0 {
        fail "`{text}` has no digits after its exponent"
    }

    let exponent = to_int(rest) catch {
        fail "`{text}` has a malformed exponent"
    }
    if exponent > MAX_SCALE {
        return MAX_SCALE
    }
    if exponent < -MAX_SCALE {
        return -MAX_SCALE
    }
    return exponent
}

// `value` divided by 10^scale, by squaring. The scale is subtracted because
// every fractional digit was read one place too high.
fn scale_by_power_of_ten(value: float, scale: int): float {
    let magnitude = 1.0
    let factor = 10.0
    let remaining = scale
    if remaining < 0 {
        remaining = -remaining
    }
    while remaining > 0 {
        if remaining % 2 == 1 {
            magnitude *= factor
        }
        remaining /= 2
        if remaining > 0 {
            factor *= factor
        }
    }

    if scale < 0 {
        return value * magnitude
    }
    return value / magnitude
}
