// bai dau tien t cho chay duoc bang Pump, 14/09/2024. Chay tu 1 den 100 chu
// khong phai 0, cai nay t cai voi thang ban mot buoi.
fn fizzbuzz(n: int): string {
    if n % 15 == 0 {
        return "FizzBuzz"
    } else if n % 3 == 0 {
        return "Fizz"
    } else if n % 5 == 0 {
        return "Buzz"
    }
    return string(n)
}

fn main() {
    for n in 1..=100 {
        println(fizzbuzz(n))
    }
}
